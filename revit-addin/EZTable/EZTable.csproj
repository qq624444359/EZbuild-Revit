<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>EZTable</AssemblyName>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>

    <!--
      One target per supported Revit, because they do not share a runtime:
      Revit 2026 is .NET 8, Revit 2027 is .NET 10. Building both needs both
      SDKs; with only one installed, name that target on the command line
      rather than editing this file:
          dotnet build -c Release -p:TargetFrameworks=net8.0-windows
    -->
    <TargetFrameworks Condition="'$(TargetFrameworks)' == ''">net8.0-windows;net10.0-windows</TargetFrameworks>
  </PropertyGroup>

  <!--
    The Revit API is compiled against reference assemblies from NuGet rather
    than the DLLs inside a Revit install, so the add-in builds on a machine
    with no Revit at all: a CI runner, or a contributor without a licence.
    Revit is still needed to run it, just not to compile it.

    Versions are pinned, not floated, so the same commit always builds the same
    binary. ExcludeAssets="runtime" keeps RevitAPI.dll out of the output: Revit
    supplies its own at load time, and shipping a copy would shadow it.
  -->
  <PropertyGroup>
    <RevitVersion Condition="'$(TargetFramework)' == 'net8.0-windows'">2026</RevitVersion>
    <RevitApiPackageVersion Condition="'$(TargetFramework)' == 'net8.0-windows'">2026.4.10</RevitApiPackageVersion>

    <RevitVersion Condition="'$(TargetFramework)' == 'net10.0-windows'">2027</RevitVersion>
    <RevitApiPackageVersion Condition="'$(TargetFramework)' == 'net10.0-windows'">2027.3.0</RevitApiPackageVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' != ''">
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitApiPackageVersion)" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitApiPackageVersion)" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.102.2" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\*.png" />
  </ItemGroup>

  <!-- The sample config follows the build output. Once renamed to
       EZTable.config it will not be overwritten by the next build. -->
  <ItemGroup>
    <None Update="EZTable.config.sample">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- After a successful build, copy everything into the Revit addins folder.
       Skipped under CI (GitHub Actions sets CI=true): a runner has no Revit to
       install into, and the release bundle is assembled by the workflow. -->
  <Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="'$(TargetFramework)' != '' And '$(CI)' != 'true'">
    <PropertyGroup>
      <AddinDir>$(AppData)\Autodesk\Revit\Addins\$(RevitVersion)</AddinDir>
      <TargetAddinDir>$(AddinDir)\EZTable</TargetAddinDir>
    </PropertyGroup>
    <MakeDir Directories="$(AddinDir)" />
    <MakeDir Directories="$(TargetAddinDir)" />
    <Copy SourceFiles="$(ProjectDir)EZTable.addin" DestinationFolder="$(AddinDir)" />
    <Copy SourceFiles="$(ProjectDir)EZTable.config.sample" DestinationFolder="$(TargetAddinDir)" />
    <ItemGroup>
      <BuiltDlls Include="$(TargetDir)*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(BuiltDlls)" DestinationFolder="$(TargetAddinDir)" />
  </Target>
</Project>
