<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>EZTable</AssemblyName>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>

    <!--
      One target per supported Revit, because they do not share a runtime:
      Revit 2026 is .NET 8, Revit 2027 is .NET 10. Building both needs both
      SDKs and both Revits installed, so with only one of them present name
      that target on the command line rather than editing this file:
          dotnet build -c Release -p:TargetFrameworks=net8.0-windows
    -->
    <TargetFrameworks Condition="'$(TargetFrameworks)' == ''">net8.0-windows;net10.0-windows</TargetFrameworks>
  </PropertyGroup>

  <!--
    Where the Revit API lives. The default is the standard install path; for an
    install elsewhere, or a different version, override on the command line
    rather than editing this file:
        dotnet build -p:RevitApiDir="D:\Autodesk\Revit 2027"
    RevitVersion is derived from the target framework and rarely needs setting
    by hand; RevitApiDir overrides it outright.
  -->
  <PropertyGroup>
    <RevitVersion Condition="'$(RevitVersion)' == '' And '$(TargetFramework)' == 'net8.0-windows'">2026</RevitVersion>
    <RevitVersion Condition="'$(RevitVersion)' == '' And '$(TargetFramework)' == 'net10.0-windows'">2027</RevitVersion>

    <RevitApiDir Condition="'$(RevitApiDir)' == '' And '$(TargetFramework)' != ''">C:\Program Files\Autodesk\Revit $(RevitVersion)</RevitApiDir>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' != ''">
    <Reference Include="RevitAPI">
      <HintPath>$(RevitApiDir)\RevitAPI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitApiDir)\RevitAPIUI.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- Say something readable when RevitAPI.dll is missing, instead of a wall
       of "the type Document could not be found" -->
  <Target Name="CheckRevitApi" BeforeTargets="ResolveAssemblyReferences" Condition="'$(TargetFramework)' != ''">
    <Error Condition="!Exists('$(RevitApiDir)\RevitAPI.dll')"
           Text="RevitAPI.dll not found at &quot;$(RevitApiDir)&quot; for target $(TargetFramework). Point the build at your Revit install with -p:RevitApiDir=&quot;C:\Path\To\Revit&quot;, or build only the target you have with -p:TargetFrameworks=net8.0-windows (Revit 2026) or -p:TargetFrameworks=net10.0-windows (Revit 2027)." />
  </Target>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.102.2" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\*.png" />
  </ItemGroup>

  <!-- The sample config follows the build output. Once renamed to
       EZTable.config it will not be overwritten by the next build. -->
  <ItemGroup>
    <None Update="EZTable.config.sample">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- After a successful build, copy everything into the Revit addins folder -->
  <Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="'$(TargetFramework)' != ''">
    <PropertyGroup>
      <AddinDir>$(AppData)\Autodesk\Revit\Addins\$(RevitVersion)</AddinDir>
      <TargetAddinDir>$(AddinDir)\EZTable</TargetAddinDir>
    </PropertyGroup>
    <MakeDir Directories="$(AddinDir)" />
    <MakeDir Directories="$(TargetAddinDir)" />
    <Copy SourceFiles="$(ProjectDir)EZTable.addin" DestinationFolder="$(AddinDir)" />
    <Copy SourceFiles="$(ProjectDir)EZTable.config.sample" DestinationFolder="$(TargetAddinDir)" />
    <ItemGroup>
      <BuiltDlls Include="$(TargetDir)*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(BuiltDlls)" DestinationFolder="$(TargetAddinDir)" />
  </Target>
</Project>
